rules_version = '2';

// Firestore security rules for the HairConsultant app.
//
// Paste this into Firebase Console -> Firestore Database -> Rules, or deploy with the
// Firebase CLI (`firebase deploy --only firestore:rules`) once this project has a
// firebase.json pointing `firestore.rules` at this file.
//
// Collections used by the app (see AppContainer.kt):
//  - users          one profile document per signed-in user, keyed by uid.
//  - consultations  face-scan / image-upload history + favorites, keyed by a random id,
//                    each document carries the owning `userId`.
//  - feedback       star ratings + written reviews, keyed by a random id, each document
//                    carries the owning `userId`.
//  - haircuts       shared, curated haircut catalog. Every user can read it; the catalog in
//                    code (SampleData.kt) is the single source of truth, and every app launch
//                    reconciles this collection to exactly match it (see
//                    HaircutRepositoryImpl.refresh / FirestoreHaircutRepository.reconcile), so
//                    signed-in clients need create/update/delete here. Don't hand-edit this
//                    collection via the console -- the next launch will overwrite/delete it.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /consultations/{consultationId} {
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /feedback/{feedbackId} {
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /haircuts/{haircutId} {
      allow read: if signedIn();
      // The app reconciles this whole collection to match its bundled catalog on every
      // launch (create/update new or changed styles, delete ones removed from the catalog).
      allow create, update, delete: if signedIn();
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
